{
  "name": "erosion-studio",
  "version": "0.1.0",
  "description": "Desktop photo and video editor for glitch art, with 100+ stackable glitch, compression and distortion effects",
  "keywords": [
    "photo-editor",
    "video-editor",
    "glitch-art",
    "datamosh",
    "effects",
    "webgl",
    "electron"
  ],
  "author": "ColemanSWE",
  "license": "MIT",
  "homepage": "https://github.com/ColemanSWE/erosion-studio#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ColemanSWE/erosion-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ColemanSWE/erosion-studio/issues"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "tsc && vite build && electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron",
    "test": "vitest run",
    "check:shaders": "SHADER_DUMP=.shader-dump.json vitest run src/lib/effects/gl/shader-dump.test.ts && electron scripts/check-shaders.cjs .shader-dump.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.8",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.263.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-resizable-panels": "^4.8.0",
    "three": "^0.163.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@webgpu/types": "^0.1.70",
    "electron": "^29.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "sass": "^1.71.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.2"
  }
}
